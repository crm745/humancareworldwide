# Copy this file to .env and fill in real values for your local machine.
# .env is never committed to git — each developer keeps their own.

DATABASE_URL="mysql://username:password@localhost:3306/humancare_dev"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
PORT=4000

# Bitrix24 inbound webhook (Settings > Developer resources > Other > Inbound webhook, CRM scope).
# Ask whoever administers HumanCare's Bitrix24 portal for this.
BITRIX24_WEBHOOK_URL="https://your-portal.bitrix24.com/rest/1/your-webhook-token/"

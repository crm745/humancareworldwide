{
  "expo": {
    "name": "HumanCare WorldWide",
    "slug": "humancare-worldwide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.humancareworldwide.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.humancareworldwide.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing"
    ],
    "scheme": "humancare",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2d77653-3b13-40b5-9bfa-50b04cd52904"
      }
    }
  }
}

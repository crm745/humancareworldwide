# Copy to .env to override. Nothing here is required to run the portal locally.

# true  = use the built-in mock API (localStorage), no backend needed.
# false = call the real Node.js/Express backend at VITE_API_BASE_URL.
VITE_USE_MOCK_API=true

# Base URL of the Express API (JWT auth). Used only when VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=http://localhost:4000/api

# Copy this file to .env and fill in real values for your local machine.
# .env is never committed to git — each developer keeps their own.

DATABASE_URL="mysql://username:password@localhost:3306/humancare_dev"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
PORT=4000

# Bitrix24 inbound webhook (Settings > Developer resources > Other > Inbound webhook, CRM scope).
# Ask whoever administers HumanCare's Bitrix24 portal for this.
BITRIX24_WEBHOOK_URL="https://your-portal.bitrix24.com/rest/1/your-webhook-token/"

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials.
# You need a separate OAuth client ID per platform; only set the ones you actually use.
GOOGLE_CLIENT_ID_IOS=""
GOOGLE_CLIENT_ID_ANDROID=""
GOOGLE_CLIENT_ID_WEB=""

# Sign in with Apple — from Apple Developer > Identifiers. Use the app's Bundle ID
# (or the Services ID if you're doing the web-based flow).
APPLE_CLIENT_ID=""

# SendGrid — for emailing OTP codes. Settings > API Keys (Restricted Access, Mail Send only).
# SENDGRID_FROM_EMAIL must be a verified sender in SendGrid (Settings > Sender Authentication).
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Twilio — for texting OTP codes. Console dashboard has Account SID + Auth Token;
# TWILIO_PHONE_NUMBER is the number you bought under Phone Numbers > Manage.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

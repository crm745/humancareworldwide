# Copy to .env to override. By default (no .env, or this file as-is) the portal calls
# the real backend — set VITE_USE_MOCK_API=true explicitly for frontend-only work
# with no backend running.

# true  = use the built-in mock API (localStorage), no backend needed.
# false = call the real Node.js/Express backend at VITE_API_BASE_URL. (default)
VITE_USE_MOCK_API=false

# Base URL of the Express API (JWT auth). Used only when VITE_USE_MOCK_API=false.
# No /api prefix — the backend mounts its routes directly (/corporate, /auth, etc).
VITE_API_BASE_URL=http://localhost:4000

# Copy this file to .env and fill in real values for your local machine.
# .env is never committed to git — each developer keeps their own.
# All vars here must be prefixed EXPO_PUBLIC_ — Expo only inlines vars with that prefix
# into the app bundle, so these are safe to expose to the client (they're just client IDs,
# never secrets).

# Where the backend API is running. Use your machine's LAN IP (not localhost) when testing
# on a physical device — e.g. http://192.168.1.5:4000
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials.
# Only set the ones you're actually testing on.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=""
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=""
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=""

# Firebase phone sign-in for the WEB build only (phones use google-services.json /
# GoogleService-Info.plist instead). From Firebase console > Project settings > General >
# Your apps > Web app > firebaseConfig. Used when the backend has PHONE_OTP_PROVIDER=firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
